# StageX Admin Backend — environment configuration
APP_ENV=development
HTTP_PORT=8081
# Same database as the participant API.
DATABASE_URL=postgres://stagex:stagex@db:5432/stagex?sslmode=disable
# Separate JWT secret from the participant API.
JWT_SECRET=dev-admin-insecure-change-me
JWT_TTL=12h
# The single admin frontend origin allowed to call this API.
CORS_ALLOW_ORIGIN=http://localhost:5174
LOG_LEVEL=info
