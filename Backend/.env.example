# StageX Backend — environment configuration
# Copy to `.env` and adjust. docker-compose reads these values.

# One of: development | staging | production
APP_ENV=development

# Port the API listens on inside the container.
HTTP_PORT=8080

# Postgres connection string (pgx format). In docker-compose the host is `db`.
DATABASE_URL=postgres://stagex:stagex@db:5432/stagex?sslmode=disable

# Secret that signs JWT access tokens. MUST be changed for production.
JWT_SECRET=dev-insecure-change-me

# Passphrase used to derive the AES key that encrypts Aadhaar at rest.
# MUST be changed for production.
AADHAAR_KEY=dev-insecure-aadhaar-key

# Access token lifetime. Accepts Go durations ("720h") or seconds.
JWT_TTL=720h

# OTP lifetime.
OTP_TTL=5m

# The single frontend origin allowed to call the API (CORS).
CORS_ALLOW_ORIGIN=http://localhost:5173

# Log level: debug | info | warn | error
LOG_LEVEL=info
